<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / transfer rules for API 31+.

  The GitHub token is excluded from both destinations. Keystore-backed keys do
  not travel with a cloud backup, and are not reissued by device-to-device
  transfer either, so in both cases the restored ciphertext would be
  undecryptable. Everything else - the notes database included - is allowed
  through, so a restored device still has the user's notes.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_gist_notes_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_gist_notes_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
