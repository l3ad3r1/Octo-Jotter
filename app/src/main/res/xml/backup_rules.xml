<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for API <= 30 (fullBackupContent).

  Notes and drafts SHOULD be backed up - getting your notes back on a new phone
  is the point. The GitHub token must NOT be: it lives in
  secure_gist_notes_prefs.xml, encrypted by an AES256-GCM key held in the
  device's hardware keystore. That key is never backed up, so restoring the
  ciphertext to another device produces a file nothing can decrypt - which used
  to throw out of EncryptedSharedPreferences.create() during startup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_gist_notes_prefs.xml" />
</full-backup-content>
